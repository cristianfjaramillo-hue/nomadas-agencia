# ========================================================
# CONFIGURACIÓN DEL PROYECTO & VARIABLES DE ENTORNO
# ========================================================

# --------------------------------------------------------
# 1. APIFY (Estudio de Mercado y Web Scraping)
# Obtén tu token en: https://console.apify.com/account/integrations
# --------------------------------------------------------
APIFY_API_TOKEN=

# --------------------------------------------------------
# 2. GITHUB (Control de Versiones y Automatización)
# Obtén tu Personal Access Token en: https://github.com/settings/tokens
# --------------------------------------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO_NAME=

# --------------------------------------------------------
# 3. VERCEL (Despliegue y Hosting Automatizado)
# Obtén tu token en: https://vercel.com/account/tokens
# Los IDs se obtienen tras inicializar el proyecto o en Settings del proyecto
# --------------------------------------------------------
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --------------------------------------------------------
# 4. INTELIGENCIA ARTIFICIAL (Opcional - Procesamiento de Estudio de Mercado y Copywriting)
# --------------------------------------------------------
GEMINI_API_KEY=

# --------------------------------------------------------
# 5. METADATOS DE LA MARCA
# --------------------------------------------------------
BRAND_NAME=
BRAND_SLOGAN=
BRAND_LOCATION=
TARGET_INDUSTRY=
TARGET_COUNTRY=

# --------------------------------------------------------
# 6. SUPABASE & PANEL CRM ADMINISTRATIVO
# Obtén tus claves en: https://supabase.com -> Project Settings -> API
# --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ADMIN_ACCESS_PASSWORD=
